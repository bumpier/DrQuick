# Waitlist storage. Attaching a KV / Upstash Redis store in the Vercel dashboard
# sets KV_REST_API_URL and KV_REST_API_TOKEN for you. Using Upstash directly,
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are read instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bearer token for GET /api/waitlist-export. Until this is set, the export route
# refuses every request — so the list can never be fetched by accident.
# Generate one with:  openssl rand -hex 32
WAITLIST_EXPORT_TOKEN=

# Optional. Salts the short-lived rate-limit key so a raw IP is never hashed
# with a value an attacker could guess. Any long random string.
RATE_LIMIT_SALT=

# Absolute origin of the deployed site, e.g. https://example.co.uk — no path.
# Production builds fail without it: og:image and twitter:image must be
# absolute URLs or no crawler renders the share card. Dev falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Blog admin accounts, one entry per admin, separated by ";":
#   email|Display Name|scrypt:16384:<salt>:<hash>
# Make an entry with:  npm run admin:hash -- you@example.com "Your Name"
# Removing an entry signs that admin out on their next request.
ADMIN_USERS=

# Signs the admin session cookie. At least 32 random characters; with a
# shorter value nobody can sign in. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Server Actions encrypt their ids with a key Next generates per build. Set this
# when the site runs on more than one instance so they share it (32 random
# bytes, base64):  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The enquiries address shown on /contact and in the legal pages. Until it is
# set, a deliberately loud placeholder shows instead.
NEXT_PUBLIC_CONTACT_EMAIL=
