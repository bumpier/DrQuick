# Postgres: waitlist, blog, analytics, finance and the admin's logs.
#   postgres://drquick:<password>@127.0.0.1:5432/drquick
# docs/postgres-vps.md sets it up on the VPS. Unset in development, `npm run
# dev` uses an in-process PGlite database in .data/pglite instead; unset in
# production, the forms answer 503 and nobody can sign in to the admin.
DATABASE_URL=

# Bearer token for GET /api/waitlist-export. Until this is set, the export route
# refuses every request — so the list can never be fetched by accident.
# Generate one with:  openssl rand -hex 32
WAITLIST_EXPORT_TOKEN=

# Optional. Salts the short-lived rate-limit key so a raw IP is never hashed
# with a value an attacker could guess. Any long random string.
RATE_LIMIT_SALT=

# Absolute origin of the deployed site, e.g. https://example.co.uk — no path.
# Production builds fail without it: og:image and twitter:image must be
# absolute URLs or no crawler renders the share card. Dev falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Blog admin accounts, one entry per admin, separated by ";":
#   email|Display Name|scrypt:16384:<salt>:<hash>
# Make an entry with:  npm run admin:hash -- you@example.com "Your Name"
# Removing an entry signs that admin out on their next request.
ADMIN_USERS=

# Signs the admin session cookie. At least 32 random characters; with a
# shorter value nobody can sign in. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Signs the doctor portal's session cookie (/doctor). At least 32 random
# characters, and a different value from the admin's; with a shorter value no
# doctor can sign in. Changing it signs every doctor out. Generate one with:
#   openssl rand -hex 32
DOCTOR_SESSION_SECRET=

# Server Actions encrypt their ids with a key Next generates per build. Set this
# when the site runs on more than one instance so they share it (32 random
# bytes, base64):  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The enquiries address shown on /contact and in the legal pages. Until it is
# set, a deliberately loud placeholder shows instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# Email through Resend (docs/email.md). Unset, nothing is sent and each attempt
# is logged as 'skipped' in the admin's Emails page. EMAIL_FROM must be on a
# domain verified in Resend, e.g.  Dr Quick <hello@drquick.co.uk>
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated addresses told about each new GP application.
ADMIN_ALERT_EMAILS=

# Stripe takes the GP sign-up fee, and a GP cannot sign up until both are set.
# Setup, testing and refunds are in docs/stripe.md.
#
# STRIPE_SECRET_KEY: unset, the GP sign-up answers "payments aren't switched
# on yet" and stores nothing. Use a RESTRICTED key (rk_...) with Checkout
# Sessions: Write, and nothing else, rather than the full secret key (sk_...).
# Test-mode and live-mode keys are different keys: use test in development.
#
# STRIPE_WEBHOOK_SECRET (whsec_...): the signing secret of the webhook endpoint
# at /api/webhooks/stripe. REQUIRED before taking a real payment: the webhook
# is what records a fee as paid and sends the confirmation email. Until both
# are set the endpoint answers 501.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
