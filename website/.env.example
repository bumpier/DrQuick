# Postgres: waitlist, blog, analytics, finance and the admin's logs.
#   postgres://drquick:<password>@127.0.0.1:5432/drquick
# docs/postgres-vps.md sets it up on the VPS. Unset in development, `npm run
# dev` uses an in-process PGlite database in .data/pglite instead; unset in
# production, the forms answer 503 and nobody can sign in to the admin.
DATABASE_URL=

# Bearer token for GET /api/waitlist-export. Until this is set, the export route
# refuses every request — so the list can never be fetched by accident.
# Generate one with:  openssl rand -hex 32
WAITLIST_EXPORT_TOKEN=

# Optional. Salts the short-lived rate-limit key so a raw IP is never hashed
# with a value an attacker could guess. Any long random string.
RATE_LIMIT_SALT=

# Absolute origin of the deployed site, e.g. https://example.co.uk — no path.
# Production builds fail without it: og:image and twitter:image must be
# absolute URLs or no crawler renders the share card. Dev falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Blog admin accounts, one entry per admin, separated by ";":
#   email|Display Name|scrypt:16384:<salt>:<hash>
# Make an entry with:  npm run admin:hash -- you@example.com "Your Name"
# Removing an entry signs that admin out on their next request.
ADMIN_USERS=

# Signs the admin session cookie. At least 32 random characters; with a
# shorter value nobody can sign in. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Signs the doctor portal's session cookie (/doctor). At least 32 random
# characters, and a different value from the admin's; with a shorter value no
# doctor can sign in. Changing it signs every doctor out. Generate one with:
#   openssl rand -hex 32
DOCTOR_SESSION_SECRET=

# Server Actions encrypt their ids with a key Next generates per build. Set this
# when the site runs on more than one instance so they share it (32 random
# bytes, base64):  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The enquiries address shown on /contact and in the legal pages. Until it is
# set, a deliberately loud placeholder shows instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# Email through Resend (docs/email.md). Unset, nothing is sent and each attempt
# is logged as 'skipped' in the admin's Emails page. EMAIL_FROM must be on a
# domain verified in Resend, e.g.  Dr Quick <hello@drquick.co.uk>
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated addresses told about each new GP application.
ADMIN_ALERT_EMAILS=

# Stripe takes the GP sign-up fee, and a GP cannot sign up until both are set.
# Setup, testing and refunds are in docs/stripe.md.
#
# STRIPE_SECRET_KEY: unset, the GP sign-up answers "payments aren't switched
# on yet" and stores nothing. Use a RESTRICTED key (rk_...) with Checkout
# Sessions: Write, and nothing else, rather than the full secret key (sk_...).
# Test-mode and live-mode keys are different keys: use test in development.
#
# STRIPE_WEBHOOK_SECRET (whsec_...): the signing secret of the webhook endpoint
# at /api/webhooks/stripe. REQUIRED before taking a real payment: the webhook
# is what records a fee as paid and sends the confirmation email. Until both
# are set the endpoint answers 501.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Encrypted video calls (docs/superpowers/specs/2026-10-13-encrypted-video-calls-design.md).
# Unset, the doctor portal says video calls are not set up, /doctor/call
# answers 501, and a GP can still complete a consultation by hand.
#
# LIVEKIT_URL: the media server's wss:// origin, nothing more. Real patients'
# calls run on our own LiveKit servers in AWS London; a production server
# refuses a *.livekit.cloud URL (LiveKit Cloud is an independent controller of
# call telemetry) unless LIVEKIT_CLOUD_TEST_ONLY marks a deployment that sees
# no patients. Read per request for the doctor portal's CSP.
#
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET: sign the two-minute passes and call the
# room API. The secret must be at least 32 characters. Server only.
#
# LIVEKIT_WEBHOOK_API_KEY / LIVEKIT_WEBHOOK_API_SECRET (optional): a separate
# key for the webhook at /api/webhooks/livekit, so it can be rotated on its
# own. Unset, webhooks are checked against the API key above.
#
# CALL_KEY_SECRET: seals each call's encryption keys at rest. At least 32
# random bytes, base64, and never one of the session secrets. Generate one with:
#   openssl rand -base64 32
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=
LIVEKIT_CLOUD_TEST_ONLY=
CALL_KEY_SECRET=

# ---------------------------------------------------------------------------
# Demo deployment (demo.drquick.co.uk): docs/demo-deploy.md sets it up. This
# block is for the demo copy's own .env.production ONLY. Never put it in the
# real site's file. NEXT_PUBLIC_DEMO and the video settings are read when
# `npm run build` runs (the patient pages are prerendered), so the whole file
# must be complete BEFORE the build. A demo build missing DEMO_DEPLOYMENT, the
# passcode or the secret answers 503 on every page. No $ in any value.
#
# The demo copy also needs, in the same file: NEXT_PUBLIC_SITE_URL=
# https://demo.drquick.co.uk, DOCTOR_SESSION_SECRET and CALL_KEY_SECRET (above),
# and LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET (a *.livekit.cloud URL
# is allowed there only because LIVEKIT_CLOUD_TEST_ONLY=1 marks a deployment
# that sees no patients). Leave the LIVEKIT_WEBHOOK_* values out.
#
# DATABASE_URL must be its own database, named with "demo" and on this machine:
#   postgres://drquick_demo:<password>@127.0.0.1:5432/drquick_demo
# The demo writes only to a loopback database whose name contains "demo". The
# name must be the URL's path, and the URL must carry no ?database=, ?db= or
# ?dbname= parameter. Any other DATABASE_URL, a DEMO_PASSCODE under 16
# characters or a DEMO_SESSION_SECRET under 32 (after trimming), and every page
# answers 503. scripts/deploy.sh with BIND_LOCAL=1 checks all of this
# (scripts/demo-preflight.mjs) before it installs, migrates or builds anything.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO=
DEMO_DEPLOYMENT=
# LIVEKIT_CLOUD_TEST_ONLY=1   (see the video block above)

# The one passcode that opens the whole demo. The rate limit is per address, so
# make it long, at least 16 characters (shorter, and the demo stays locked with
# "Demo not configured"): four random words, or  openssl rand -base64 12
# Changing it signs everyone out. Share it with the presenter privately.
DEMO_PASSCODE=
# Signs the demo's passcode session (the dq_demo cookie, 12 hours). At least 32
# random characters, different from the other secrets. Generate one with:
#   openssl rand -hex 32
DEMO_SESSION_SECRET=
